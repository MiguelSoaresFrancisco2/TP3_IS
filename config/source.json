{
  "name": "jdbc-source-events-example",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSourceConnector",
    "connection.url": "jdbc:postgresql://database:5432/project3",
    "connection.user": "postgres",
    "connection.password": "nopass",
    "dialect.name": "PostgreSqlDatabaseDialect",
    "mode": "bulk",
    "query": "SELECT event_id, event_name, city, category, base_ticket_price FROM events",
    "poll.interval.ms": "60000",
    "topic.prefix": "project3fromDB"
  }
}